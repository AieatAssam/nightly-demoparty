{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightly-demoparty.invalid/schemas/usage-entry.schema.json",
  "title": "Usage entry",
  "description": "One JSON line of audit/usage.jsonl: token usage and cost of one Claude Code invocation, written by the .github/actions/agent composite action. The weekly retrospective flags any stage whose 7-night average grew over 25%.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "date",
    "run_id",
    "stage",
    "attempt",
    "model",
    "effort",
    "input_tokens",
    "output_tokens",
    "cache_read_tokens",
    "cache_creation_tokens",
    "cost_usd",
    "duration_ms",
    "num_turns"
  ],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time", "description": "When the invocation finished." },
    "date": { "$ref": "plan.schema.json#/$defs/date", "description": "Night the run belongs to (week_ending for the retro)." },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 64, "description": "GitHub Actions run id, or 'local-...' for local dry runs." },
    "stage": { "$ref": "#/$defs/stage" },
    "attempt": { "type": "integer", "minimum": 1, "description": "Invocation count for this stage tonight (build attempt, brief retry, jury repeat)." },
    "model": { "type": "string", "minLength": 1, "maxLength": 64 },
    "effort": { "type": ["string", "null"], "maxLength": 16, "description": "Effort flag, null when not passed." },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "cache_read_tokens": { "type": "integer", "minimum": 0 },
    "cache_creation_tokens": { "type": "integer", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "num_turns": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "stage": {
      "type": "string",
      "enum": ["research", "appraise", "brief", "build", "jury", "retro"],
      "description": "LLM stage name; matches prompts/<stage>.md."
    }
  }
}
